{
  "version": "0.2",
  "fields": [
    { "claude": "name", "codex": "name", "level": "exact" },
    { "claude": "description", "codex": "description", "level": "exact" },
    { "claude": "body", "codex": "developer_instructions", "level": "equivalent" },
    { "claude": "model", "codex": "model", "level": "approximate", "alias_table": "models.tiers" },
    { "claude": "tools", "codex": "sandbox_mode", "level": "approximate", "map": "sandbox_modes" },
    { "claude": "color", "codex": null, "level": "metadata-only" },
    { "claude": "memory", "codex": null, "level": "metadata-only" },
    { "claude": null, "codex": "model_reasoning_effort", "level": "metadata-only" }
  ],
  "sandbox_modes": {
    "read-only": {
      "claude": { "tools": ["Read", "Grep", "Glob"] }
    },
    "workspace-write": {
      "claude": { "tools": ["Bash", "Edit", "MultiEdit", "Read", "Grep", "Glob", "Write"] }
    },
    "danger-full-access": {
      "claude": { "tools": ["Bash", "Edit", "MultiEdit", "Read", "Grep", "Glob", "Write"] }
    }
  },
  "models": {
    "description": "Single source of truth for model mapping. `alias` is the canonical token written into converted frontmatter and prose. `terms` are additional accepted spellings of the same tier — every one is also a recognized frontmatter model value, which is how retired ids and vendor-tagged variants (gpt-5.3-codex, gpt-5.1-codex-max) still convert instead of passing through unmapped. Tiers are ordered strongest first; on a duplicate token the earlier tier wins.",
    "tiers": [
      {
        "id": "mythos-class-model",
        "claude": {
          "alias": "fable",
          "terms": ["fable(latest)", "Claude Fable 5", "Fable 5"]
        },
        "codex": {
          "alias": "gpt-5.6-sol",
          "terms": ["gpt-5.6", "GPT-5.6 Sol", "GPT-5.6-Sol"]
        }
      },
      {
        "id": "latest-frontier-model",
        "claude": {
          "alias": "opus",
          "terms": ["opus(latest)", "Claude Opus 5", "Opus 5", "Opus"]
        },
        "codex": {
          "alias": "gpt-5.6-terra",
          "terms": [
            "gpt-5.5",
            "gpt-5.3-codex",
            "gpt-5.1-codex-max",
            "GPT-5.6 Terra",
            "GPT-5.6-Terra"
          ]
        }
      },
      {
        "id": "balanced-model",
        "claude": {
          "alias": "sonnet",
          "terms": ["sonnet(latest)", "Claude Sonnet 5", "Claude Sonnet", "Sonnet 5", "Sonnet"]
        },
        "codex": {
          "alias": "gpt-5.6-luna",
          "terms": ["gpt-5.4", "gpt-5.1-codex-mini", "GPT-5.6 Luna", "GPT-5.6-Luna", "GPT-5.4"]
        }
      },
      {
        "id": "small-fast-model",
        "claude": {
          "alias": "haiku",
          "terms": ["haiku(latest)", "Claude Haiku 4.5", "Claude Haiku", "Haiku 4.5", "Haiku"]
        },
        "codex": {
          "alias": "gpt-5.4-mini",
          "terms": ["gpt-5.4-nano", "GPT-5.4-Mini"]
        }
      }
    ]
  },
  "migration_preamble_pattern": "^Migrated from (Claude|Codex) agent: [^\\n]+\\n\\n"
}
